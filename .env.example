# The runner does not auto-load this file. Export values through your shell or
# use an authenticated Claude Code environment.
ANTHROPIC_API_KEY=

# Optional workspace override. The public example is used when this is unset
# and no wizengamot.local.toml exists.
WIZENGAMOT_WORKSPACE=examples/atlas

# Conservative defaults. Increase only after calibration.
WIZENGAMOT_CONCURRENCY=8
WIZENGAMOT_AGENT_BUDGET_USD=0.50
