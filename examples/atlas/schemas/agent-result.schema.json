{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wizengamot agent report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_name",
    "status",
    "epistemic_notice",
    "executive_summary",
    "findings",
    "risks",
    "falsifiers",
    "recommendations",
    "evidence_gaps",
    "citations",
    "actions",
    "evidence_bar_review",
    "handoff"
  ],
  "properties": {
    "agent_name": {"type": "string"},
    "status": {"type": "string", "enum": ["complete", "partial", "blocked"]},
    "epistemic_notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_generated", "report_is_evidence", "moves_empirical_validation"],
      "properties": {
        "model_generated": {"const": true},
        "report_is_evidence": {"const": false},
        "moves_empirical_validation": {"const": false}
      }
    },
    "executive_summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "classification",
          "evidence_class",
          "novelty",
          "claim_type",
          "source_ids",
          "reviewed_source_ids",
          "confidence",
          "impact",
          "evidence"
        ],
        "properties": {
          "statement": {"type": "string"},
          "classification": {
            "type": "string",
            "enum": ["fact", "project-record", "hypothesis", "inference", "recommendation", "legal-question", "unknown"]
          },
          "evidence_class": {
            "type": "string",
            "enum": ["customer-evidence", "project-record", "external-primary", "external-secondary", "model-reasoning", "unknown"]
          },
          "novelty": {
            "type": "string",
            "enum": ["retrieved", "derived", "corroborated", "contradicted", "novel", "unresolved"]
          },
          "claim_type": {
            "type": "string",
            "enum": ["positive", "negative-capability", "comparative", "other"]
          },
          "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "reviewed_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "confidence": {"type": "string", "enum": ["high", "moderate", "low", "unknown"]},
          "impact": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "falsifiers": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}},
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "label",
          "source_class",
          "publisher",
          "source",
          "locator",
          "date",
          "primary",
          "claims_supported"
        ],
        "properties": {
          "source_id": {"type": "string"},
          "label": {"type": "string"},
          "source_class": {
            "type": "string",
            "enum": ["customer-evidence", "project-record", "external-primary", "external-secondary", "unknown"]
          },
          "publisher": {"type": ["string", "null"]},
          "source": {"type": "string"},
          "locator": {"type": ["string", "null"]},
          "date": {"type": ["string", "null"]},
          "primary": {"type": ["boolean", "null"]},
          "claims_supported": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "owner", "target_date", "action_type", "reversibility", "evidence_bar", "rationale"],
        "properties": {
          "description": {"type": "string"},
          "owner": {"type": "string"},
          "target_date": {"type": ["string", "null"]},
          "action_type": {"type": "string", "enum": ["external", "internal"]},
          "reversibility": {"type": "string", "enum": ["reversible", "partially-reversible", "irreversible"]},
          "evidence_bar": {"type": "string", "enum": ["near-zero", "low", "moderate", "high"]},
          "rationale": {"type": "string"}
        }
      }
    },
    "evidence_bar_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_threshold", "prior_threshold", "drift_direction", "drift_basis", "recommendation"],
      "properties": {
        "current_threshold": {"type": "string", "enum": ["near-zero", "low", "moderate", "high", "unknown"]},
        "prior_threshold": {"type": ["string", "null"], "enum": ["near-zero", "low", "moderate", "high", "unknown", null]},
        "drift_direction": {"type": "string", "enum": ["rising", "stable", "falling", "unknown"]},
        "drift_basis": {"type": "string", "enum": ["external-evidence", "customer-raised", "operational-constraint", "model-generated", "unknown"]},
        "recommendation": {"type": "string"}
      }
    },
    "handoff": {"type": "array", "items": {"type": "string"}},
    "artifact_markdown": {"type": ["string", "null"]},
    "decision_log": {"type": "array", "items": {"type": "string"}},
    "source_report_paths": {"type": "array", "items": {"type": "string"}}
  }
}
